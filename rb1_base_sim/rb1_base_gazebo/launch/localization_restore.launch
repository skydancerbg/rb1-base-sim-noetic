<?xml version="1.0"?>
<!--
  Put localisation back after a SLAM session (plan step P2.5).

  Every argument here is copied from `rb1_base_one_robot.launch`, which is the only reason this
  works: an ad-hoc `roslaunch amcl.launch` during development brought AMCL up with the wrong scan
  remap and a map server pointed at a file that did not exist, and the robot was left blind while
  every unit still reported "started". If the navigation launch's arguments change, change them
  here in the same commit.

  The map file defaults to the saved neo_workshop map - the one a session has just written - so
  stopping a session restores localisation against the map that was just built, not the one it
  started from.
-->
<launch>
  <arg name="id_robot" default="robot"/>
  <arg name="prefix" value="$(arg id_robot)_"/>
  <arg name="global_frame" default="$(arg prefix)map"/>
  <arg name="map_file" default="$(find rb1_base_localization)/maps/neo_workshop/neo_workshop.yaml"/>
  <arg name="x_init_pose" default="0.0"/>
  <arg name="y_init_pose" default="0.0"/>
  <arg name="z_init_pose" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>

  <group ns="$(arg id_robot)">
    <include file="$(find rb1_base_localization)/launch/map_server.launch">
      <arg name="prefix" value="$(arg prefix)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="frame_id" value="$(arg global_frame)"/>
    </include>

    <include file="$(find rb1_base_localization)/launch/amcl.launch">
      <arg name="global_frame" value="$(arg global_frame)"/>
      <arg name="prefix" value="$(arg prefix)"/>
      <arg name="x_init_pose" value="$(arg x_init_pose)"/>
      <arg name="y_init_pose" value="$(arg y_init_pose)"/>
      <arg name="z_init_pose" value="$(arg z_init_pose)"/>
      <arg name="init_yaw" value="$(arg init_yaw)"/>
    </include>
  </group>
</launch>
