<?xml version="1.0"?>
<launch>
  <arg name="launch_rviz" default="false"/>
  <arg name="rviz_config" default="$(find rb1_base_gazebo)/rviz/rb1_base.rviz"/>
  <arg name="teleop_config" default="$(find rb1_base_gazebo)/config/neo_workshop_f710_xinput_twist_joy.yaml"/>
  <arg name="echo_pad_cmd_vel" default="false"/>

  <include file="$(find rb1_base_gazebo)/launch/rb1_neo_workshop_mapping.launch">
    <arg name="launch_rviz" value="$(arg launch_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
    <arg name="launch_auto_map" value="false"/>
  </include>

  <group ns="robot">
    <node pkg="joy" type="joy_node" name="joy_node" output="screen" respawn="true">
      <rosparam command="load" file="$(find rb1_base_gazebo)/config/neo_workshop_joy.yaml"/>
    </node>

    <node name="teleop_twist_joy" pkg="teleop_twist_joy" type="teleop_node" output="screen">
      <rosparam command="load" file="$(arg teleop_config)"/>
      <remap from="cmd_vel" to="pad_teleop/cmd_vel_raw"/>
    </node>

    <node name="manual_speed_selector"
          pkg="rb1_base_gazebo"
          type="manual_speed_selector.py"
          output="screen">
      <param name="joy_topic" value="joy"/>
      <param name="input_cmd_vel_topic" value="pad_teleop/cmd_vel_raw"/>
      <param name="output_cmd_vel_topic" value="pad_teleop/cmd_vel"/>
      <param name="normal_multiplier" value="1.0"/>
      <param name="turbo_multiplier" value="1.6"/>
      <param name="mode_axis_turbo" value="7"/>
      <param name="mode_axis_normal" value="7"/>
      <param name="mode_axis_threshold" value="0.5"/>
      <param name="enable_button" value="5"/>
      <param name="left_linear_axis" value="1"/>
      <param name="left_angular_axis" value="0"/>
      <param name="left_linear_scale" value="0.35"/>
      <param name="left_angular_scale" value="0.8"/>
    </node>

    <node if="$(arg echo_pad_cmd_vel)"
          name="echo_pad_cmd_vel"
          pkg="rostopic"
          type="rostopic"
          output="screen"
          args="echo /robot/pad_teleop/cmd_vel"/>
  </group>
</launch>
